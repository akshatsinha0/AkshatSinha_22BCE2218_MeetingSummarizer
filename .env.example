# Backend configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Choose a local model that you have/downloaded in Ollama
OLLAMA_MODEL=qwen3:4b
WHISPER_MODEL=large-v3
# Absolute path to ffmpeg.exe if not in PATH
# Leave as 'ffmpeg' if it's in your system PATH, or provide full path
# Example for winget install: C:\\Users\\<YourUsername>\\AppData\\Local\\Microsoft\\WinGet\\Packages\\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\\ffmpeg-8.0-full_build\\bin\\ffmpeg.exe
FFMPEG_BIN=ffmpeg

# Diarization (pyannote) – get a free HF token: https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional cloud toggle (kept off by default)
TRANSCRIBE_PROVIDER=local
DAILY_ASR_BUDGET_MIN=0
CLOUD_FALLBACK=never
CONF_THRESHOLD=0.4

# Suppress OpenMP duplicate library warning
KMP_DUPLICATE_LIB_OK=TRUE
